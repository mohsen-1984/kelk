{
  "plansDirectory": ".claude/plans",
  "autoMemoryEnabled": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/archive-completed-plans.sh",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Archiving completed plans..."
          },
          {
            "type": "command",
            "command": "node .claude/scripts/contributelog.mjs stop-hook",
            "timeout": 30,
            "statusMessage": "Updating ContributeLog and checking the project rules..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/context-watch.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking context window usage..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/resume-note-pointer.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for a waiting /checkpoint resume note..."
          },
          {
            "type": "command",
            "command": "node .claude/scripts/contributelog.mjs session-start",
            "timeout": 10,
            "statusMessage": "Pointing git at the project's commit hooks..."
          }
        ]
      }
    ]
  }
}
