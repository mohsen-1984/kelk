    "check:version": "node tools/check-version.js",
    "check:i18n": "node tools/check-i18n.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "playwright": "1.56.1",
    "prettier": "3.9.10"
  }
