{
  "_about": "What the import report must say of a lab file (scripts/report-expect.js; the gate checks it). Codes: garbledText (a font's text is not language: lib/pdfimport/trust.js, the judge), hiddenText (text no reader sees, given in the hidden-text block), fontprintRead (a font's characters read from its outlines: the font arbiter). lostText (glyphs of the page missing from the Markdown) is not written by the importer yet.",
  "never": ["garbledText"],
  "neverExcept": ["wk-rtl--"],
  "files": {
    "word-bfonts--faces-fa": { "not": ["garbledText", "hiddenText", "lostText", "fontprintRead"] },
    "word-bfonts--tounicode-fa": { "has": ["fontprintRead"], "not": ["garbledText"] },
    "word-cover--glyph-index-fa": { "has": ["garbledText"], "not": ["fontprintRead", "hiddenText"] },
    "word-bfonts--parens-fa": { "has": ["fontprintRead"], "not": ["hiddenText", "garbledText"] },
    "driver-print--renumbered-fa": { "has": ["fontprintRead", "hiddenText"], "not": ["garbledText"] },
    "driver-print--renumbered-pages-fa": { "has": ["fontprintRead", "hiddenText"], "not": ["garbledText"] },
    "driver-print--renumbered-en": { "has": ["garbledText", "hiddenText"], "confBelow": 0.5, "_note": "a font Kelk has no fontprints of: it stays reported, not read" },
    "word-hidden--hidden-fa": { "has": ["hiddenText"], "not": ["garbledText"] },
    "word-print--word-rtl": { "has": ["hiddenText"], "not": ["garbledText"] },
    "word-contact--contact-fa": { "not": ["garbledText", "hiddenText", "lostText"] },
    "word-labels--labels-fa": { "not": ["garbledText", "hiddenText", "lostText"] },
    "wk-rtl--fa-article": { "not": ["garbledText"] },
    "chrome-github-bg--symbols": { "not": ["garbledText"] },
    "wk-github--symbols": { "not": ["garbledText"] }
  }
}
