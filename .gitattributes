# Text files are stored with LF and checked out with LF on every platform (core.autocrlf is overridden).
# A CRLF corpus .md would shift the lab's scores.
* text=auto eol=lf

# Shell and Node scripts keep LF line endings on every platform.
*.sh text eol=lf
*.mjs text eol=lf

# Binary: never normalised or diffed as text.
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.TTF binary
*.otf binary
*.pfb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wasm binary
*.bcmap binary
*.docx binary
*.doc binary
*.xlsx binary
*.pptx binary
*.odt binary

# Third-party schemas kept byte for byte as published (their CRLF line ends too), so tests/ooxml-xsd/README.md hashes hold
tests/ooxml-xsd/** -text
